# Cloudflare Pages response headers (copied to dist/). Rules apply in order; "! Header" removes a
# value set by an earlier matching rule, so hashed files end up immutable and the rest no-cache.
/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/workbox-*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
