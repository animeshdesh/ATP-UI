# Backend API base URL (atp-backend)
VITE_API_URL=http://localhost:4553
# supabase: real sign-in + L2 API. mock: in-memory auth and data, no backend needed.
VITE_AUTH=supabase
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_PUBLISHABLE_KEY=
# Sign-in feature flags. Unset = on in dev/tests, off in deployed builds.
# VITE_PHONE_AUTH=true
# VITE_MAGIC_LINK=true
# Serve contract endpoints from MSW in the browser (dev only)
VITE_API_MOCKING=false
