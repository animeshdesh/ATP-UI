# Deployed builds (committed). Cloudflare Pages builds `pnpm build` for both environments:
# branch `production` → app.<domain>, branch `main` → staging.<domain> (D-040/D-041).
# Per-environment Pages variables provide VITE_API_URL (https://api[-staging].<domain>),
# VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY; the build fails without them.
VITE_AUTH=supabase
VITE_API_MOCKING=false
