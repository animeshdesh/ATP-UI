# Staging build (`vite build --mode staging`) (committed). Same-origin: Caddy serves the PWA and proxies /api to the API (D-037).
# VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY come from CI (or .env.staging.local);
# the build fails without them.
VITE_API_URL=/api
VITE_AUTH=supabase
VITE_API_MOCKING=false
